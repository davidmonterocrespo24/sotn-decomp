# SOTN on the XIAO ESP32S3 Sense — the handheld console.
#
# Same chip as the Waveshare board (S3R8: 8 MB octal PSRAM), so everything that
# matters for speed carries over unchanged. Only three things differ, and all
# three are consequences of the board rather than choices:
#
#   - 8 MB of flash instead of 16, so a different partition table with no data
#     partition (the Sense's own microSD holds the disc assets)
#   - the console goes over the native USB port; there is no UART bridge
#   - flash AND PSRAM both at 80 MHz
#
# That last one is not a free choice. The S3's MSPI timing tables only cover
# certain flash/PSRAM speed pairs, and 80 MHz flash with 120 MHz PSRAM is not
# one of them — the build dies on a missing
# MSPI_TIMING_FLASH_CONFIG_TABLE_..._MODULE_CLK_80M symbol, which reads like a
# toolchain fault and is really "that combination does not exist". So the two
# move together: either both 120 or both 80.
#
# Both 80 to start, deliberately. The Waveshare board runs this game at a
# locked 60 fps on 120/120, but that grade belongs to ITS flash part and this
# is a different module. Get it running on the guaranteed setting first; 120/120
# is then a single-variable experiment with a frame-rate number on either side,
# which is the only honest way to know whether it is worth the risk here.
#
# Build with:  build.ps1 xiao
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# no UART bridge on this board: the console is the native USB peripheral.
# This is also why nothing may install the UART0 driver — GPIO43 is the
# panel's data/command pin here (see board_pins_xiao.h).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# SOTN statics (~4.6MB budget) go to PSRAM via EXT_RAM_BSS_ATTR
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# cache config: NOT defaults; required-safe with octal PSRAM (64B wrap bursts)
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_xiao.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y
# engine uses C++ with no exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# without this the 120 MHz PSRAM option is not even offered, and the failure
# reads like a hardware limit rather than a hidden menu entry. Left on so the
# 120/120 experiment above is a one-line change.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
